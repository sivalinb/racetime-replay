# Optional. The local workflow works without API keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Opt-in sanitized evaluation tracing; user media and raw health data are not sent.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=racetime-replay-evaluation
REPLAY_TRACE=false
# Only enable on a trusted local machine or authenticated private deployment.
REPLAY_ALLOW_UPLOADS=true
# Requires requirements-safety.txt; errors fail closed.
REPLAY_FRAMEWORK_GUARDS=false
# Optional Nebius Token Factory provider. Get a current chat model ID with
# PYTHONPATH=. python scripts/check_nebius.py --list-models
NEBIUS_API_KEY=
NEBIUS_MODEL=
REPLAY_LLM_PROVIDER=gemini
# Optional manual Braintrust tracing; scripts use synthetic data only.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_ID=
